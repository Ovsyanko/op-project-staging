RewriteRule ^contacts\.html$ /contacts/ [R=301,L]
RewriteRule ^drying\.html$ /drying/ [R=301,L]
RewriteRule ^insulation\.html$ /insulation/ [R=301,L]
RewriteRule ^offers\.html$ /offers/ [R=301,L]
RewriteRule ^optimisation\.html$ /optimisation/ [R=301,L]
RewriteRule ^page\-derevo\.html$ /page-derevo/ [R=301,L]
RewriteRule ^pellets\.html$ /pellets/ [R=301,L]
RewriteRule ^plant\.html$ /plant/ [R=301,L]
RewriteRule ^policy\.html$ /policy/ [R=301,L]
RewriteRule ^poultry\.html$ /poultry/ [R=301,L]
RewriteRule ^presswood\.html$ /presswood/ [R=301,L]
RewriteRule ^referencelist\.html$ /referencelist/ [R=301,L]
RewriteRule ^revision\.html$ /revision/ [R=301,L]
RewriteRule ^tech\-audit\.html$ /tech-audit/ [R=301,L]
RewriteRule ^tech\-project\.html$ /tech-project/ [R=301,L]
