DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.op-project\.ru$ [NC]
RewriteRule ^(.*)$ https://op-project.ru/$1 [R=301,L]

RewriteRule ^agro\.html$ /agro/ [R=301,L]
RewriteRule ^callmeback\.html$ /callmeback/ [R=301,L]
