RewriteEngine On

# Keep the temporary op-co.ru copy out of search indexes.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

# GitHub staging files still contain /op-project-staging/ in many static URLs.
# Strip that prefix internally for files, so CSS/JS/images/fonts work from domain root.
RewriteRule ^op-project-staging/(.+\.[A-Za-z0-9]+)$ /$1 [L]

# Hide the GitHub staging prefix from visible page URLs.
RewriteRule ^op-project-staging/?$ / [R=302,L]
RewriteRule ^op-project-staging/(.+)/?$ /$1 [R=302,L]

DirectoryIndex index.html
